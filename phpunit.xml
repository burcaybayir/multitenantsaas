<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Tests run against real MySQL and Redis: tenancy isolation depends
            on engine behaviour (per-tenant MySQL users, Redis prefixes, cache
            tags) that SQLite/array drivers can't reproduce.
            force="true" so container env vars (docker compose) can't point
            the suite at the development database.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CENTRAL_DOMAINS" value="installhub.localhost" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="installhub_testing" force="true"/>
        <env name="DB_URL" value=""/>
        <env name="TENANCY_DB_PREFIX" value="tenant_test_" force="true"/>
        <env name="CACHE_STORE" value="redis" force="true"/>
        <env name="REDIS_DB" value="10" force="true"/>
        <env name="REDIS_CACHE_DB" value="11" force="true"/>
        <env name="REDIS_QUEUE_DB" value="12" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="database" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
