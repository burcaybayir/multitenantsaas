APP_NAME=InstallHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://installhub.localhost

# Comma-separated. Tenants live at <subdomain>.<central domain>.
# *.localhost resolves to 127.0.0.1 in modern browsers/curl, no hosts file needed.
CENTRAL_DOMAINS=installhub.localhost
TENANCY_DB_PREFIX=tenant_

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Central database. The app user needs CREATE USER + GRANT OPTION on
# `tenant\_%` (see docker/mysql/init.sql); never use root here.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=installhub
DB_USERNAME=installhub
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# Sessions live in each tenant's own database (host-only cookie).
# Never set SESSION_DOMAIN to a wildcard such as .installhub.localhost:
# that would send one tenant's session cookie to every other tenant.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Tag-based tenant cache isolation requires a store that supports tags.
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@installhub.localhost"
MAIL_FROM_NAME="${APP_NAME}"

# installhub/epc-client (packages/epc-client). Register for an EPC API key at
# https://epc.opendatacommunities.org; postcodes.io needs no key.
EPC_API_EMAIL=
EPC_API_KEY=
POSTCODES_IO_BASE_URL=https://api.postcodes.io

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
